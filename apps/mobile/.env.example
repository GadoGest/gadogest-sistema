# Copie este arquivo para ".env" e preencha com os dados do projeto gadogest-dev
# (painel do Supabase: Connect ou Project Settings > API Keys).
# Use só a chave "publishable". Nunca coloque aqui a chave "secret"/"service_role".
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_SUA_CHAVE

# URL da instância Development do PowerSync (ligada ao gadogest-dev). Não é segredo.
EXPO_PUBLIC_POWERSYNC_URL=https://6afcc9d43224a694a45abf6e.powersync.journeyapps.com
