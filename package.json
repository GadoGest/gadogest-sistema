    "format:check": "prettier --check .",
    "avisos": "node scripts/avisos.mjs",
    "prepare": "node scripts/instalar-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
